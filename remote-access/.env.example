REMOTE_ENABLED=false
REMOTE_LISTEN=127.0.0.1:8080
REMOTE_PUBLIC_ORIGIN=https://infrascope.example.internal
REMOTE_STATIC_DIR=../dist
DATABASE_URL=postgres://infrascope:CHANGE_ME@127.0.0.1:5432/infrascope?sslmode=verify-full
REMOTE_WORKSPACE=default
REMOTE_GATEWAY_ID=gateway-1
# Explicit CIDR allowlist; no target network is enabled by default.
REMOTE_ALLOWED_CIDRS=
# JSON keyring of base64-encoded 32-byte AES keys; inject via secret manager.
REMOTE_SECRET_KEYS={}
REMOTE_ACTIVE_KEY_VERSION=key-1
REMOTE_SESSION_HOURS=8
REMOTE_MAX_SESSIONS_PER_USER=8
REMOTE_MAX_TRANSFERS_PER_USER=3
REMOTE_SSH_IDLE_SECONDS=1800
REMOTE_SSH_MAX_SECONDS=28800
REMOTE_SSH_REATTACH_SECONDS=60
REMOTE_REVOKE_POLL_SECONDS=5
# Local isolated tests only; production refuses HTTP unless this is true and origin/listen are loopback.
REMOTE_LOOPBACK_TEST=false

REMOTE_MAX_SFTP_CHANNELS=32
REMOTE_MAX_SSH_GATEWAY=128
REMOTE_BANDWIDTH_BYTES_PER_USER=16777216
# Trusted peer TLS origins only. Each peer shares the same DB/keyring/public Origin.
REMOTE_GATEWAY_PEERS={}
REMOTE_ALLOW_TEMPORARY_SSH_CREDENTIALS=false
