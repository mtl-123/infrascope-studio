[Unit]
Description=InfraScope application and remote access gateway
After=network-online.target
Wants=network-online.target
[Service]
User=infrascope
Group=infrascope
WorkingDirectory=/opt/infrascope/remote-access
EnvironmentFile=/etc/infrascope/remote-access.env
ExecStart=/opt/infrascope/remote-access/bin/infrascope serve
Restart=on-failure
RestartSec=35
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target
